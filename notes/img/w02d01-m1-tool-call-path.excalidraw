{"type": "excalidraw", "version": 2, "source": "claude", "elements": [{"type": "text", "id": "ttl", "x": 150, "y": 14, "text": "One tool call, four places it can go wrong", "fontSize": 24, "fontFamily": 1, "strokeColor": "#1e1e1e", "width": 500, "height": 30}, {"type": "rectangle", "id": "b1", "x": 20, "y": 80, "width": 160, "height": 110, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#4a9eed", "strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "boundElements": [{"type": "text", "id": "b1t"}]}, {"type": "text", "id": "b1t", "x": 30, "y": 95.0, "width": 140, "height": 80, "text": "1. Model reads\nthe tool list\n(name, description,\nschema)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "b1", "strokeColor": "#1e1e1e"}, {"type": "arrow", "id": "a0", "x": 180, "y": 135, "width": 40, "height": 0, "points": [[0, 0], [40, 0]], "endArrowhead": "arrow", "startArrowhead": null, "strokeColor": "#1e1e1e", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0}, {"type": "arrow", "id": "h0", "x": 100, "y": 190, "width": 0, "height": 50, "points": [[0, 0], [0, 50]], "endArrowhead": "arrow", "startArrowhead": null, "strokeColor": "#ef4444", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0}, {"type": "rectangle", "id": "x0", "x": 20, "y": 240, "width": 160, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#ef4444", "strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "boundElements": [{"type": "text", "id": "x0t"}]}, {"type": "text", "id": "x0t", "x": 30, "y": 255.0, "width": 140, "height": 60, "text": "Picks the wrong\ntool, or skips\none it needed", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "x0", "strokeColor": "#1e1e1e"}, {"type": "rectangle", "id": "b2", "x": 220, "y": 80, "width":