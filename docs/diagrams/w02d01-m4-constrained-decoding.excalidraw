strokeColor": "#ef4444", "type": "rectangle", "id": "d1", "x": 370, "y": 170, "width": 220, "height": 40, "backgroundColor": "#ffc9c9", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "d1L"}]}, {"type": "text", "id": "d1L", "x": 380, "y": 180.0, "width": 200, "height": 20, "text": "\"file SAR\"  BLOCKED", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d1", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#22c55e", "type": "rectangle", "id": "d2", "x": 370, "y": 220, "width": 220, "height": 40, "backgroundColor": "#b2f2bb", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "d2L"}]}, {"type": "text", "id": "d2L", "x": 380, "y": 230.0, "width": 200, "height": 20, "text": "\"enhanced due...\"  0.64", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d2", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#22c55e", "type": "rectangle", "id": "d3", "x": 370, "y": 270, "width": 220, "height": 40, "backgroundColor": "#b2f2bb", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "d3L"}]}, {"type": "text", "id": "d3L", "x": 380, "y": 280.0, "width": 200, "height": 20, "text": "\"escalate\"  0.36", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d3", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#ef4444", "type": "rectangle", "id": "d4", "x": 370, "y": 320, "width": 220, "height": 40, "backgroundColor": "#ffc9c9", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "d4L"}]}, {"type": "text", "id": "d4L", "x": 380, "y": 330.0, "width": 200, "height": 20, "text": "\"}\"  BLOCKED", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "d4", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#1e1e1e", "type": "arrow", "id": "a2", "x": 600, "y": 265, "points": [[0, 0], [50, 0]], "width": 50, "height": 0, "endArrowhead": "arrow", "startArrowhead": null}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#f59e0b", "type": "rectangle", "id": "pick", "x": 655, "y": 230, "width": 130, "height": 70, "backgroundColor": "#fff3bf", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "pickL"}]}, {"type": "text", "id": "pickL", "x": 665, "y": 235.0, "width": 110, "height": 60, "text": "3. Sample\nfrom the\nlegal ones", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "pick", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#f59e0b", "type": "rectangle", "id": "note", "x": 40, "y": 400, "width": 720, "height": 110, "backgroundColor": "#fff3bf", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "noteL"}]}, {"type": "text", "id": "noteL", "x": 50, "y": 415.0, "width": 700, "height": 80, "text": "\"file SAR\" isn't in the action enum and \"}\" would end the object too early,\nso both get probability 0. The rest are renormalised (0.35/0.55 = 0.64).\nRepeated for EVERY token: the output can't leave the schema.\nBut the model can still pick the WRONG legal value. (Numbers illustrative.)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "note", "strokeColor": "#1e1e1e"}], "appState": {"viewBackgroundColor": "#ffffff"}}