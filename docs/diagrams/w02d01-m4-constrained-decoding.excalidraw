{"type": "excalidraw", "version": 2, "source": "claude", "elements": [{"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#1e1e1e", "type": "text", "id": "t", "x": 150, "y": 10, "text": "Constrained decoding: masking the next token", "fontSize": 24, "fontFamily": 1, "width": 528.0, "height": 30.0}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#757575", "type": "rectangle", "id": "so", "x": 20, "y": 60, "width": 760, "height": 50, "backgroundColor": "#e9ecef", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "soL"}]}, {"type": "text", "id": "soL", "x": 30, "y": 75.0, "width": 740, "height": 20, "text": "Written so far:  {\"alert_id\": \"A-1002\", \"typology\": \"high-risk wires\", \"action\": \"  ...next?", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "so", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#1e1e1e", "type": "text", "id": "h1", "x": 40, "y": 130, "text": "1. Model scores candidates", "fontSize": 20, "fontFamily": 1, "width": 260.0, "height": 25.0}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#8b5cf6", "type": "rectangle", "id": "c1", "x": 40, "y": 170, "width": 220, "height": 40, "backgroundColor": "#d0bfff", "roundness": {"type": 3}, "boundElements": [{"type": "text", "id": "c1L"}]}, {"type": "text", "id": "c1L", "x": 50, "y": 180.0, "width": 200, "height": 20, "text": "\"file SAR\"  0.40", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "c1", "strokeColor": "#1e1e1e"}, {"strokeWidth": 2, "roughness": 1, "opacity": 100, "angle": 0, "fillStyle": "solid", "strokeColor": "#8b5cf6", "type": "rectangle", "id": "c2", "x": 40, "y": 220, "width": 220, "height": 40, "backgroundColor": "#d0bfff", "roundnes